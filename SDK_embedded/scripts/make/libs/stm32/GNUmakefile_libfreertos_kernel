LIBNAME = libfreertos_kernel

LIB_SRC_DIR=$(FREERTOS_KERNEL_SRC_DIR)

NO_SUBDIR_WALKER=1

include $(SRC_DIR)/rules.mk

CFLAGS +=	-I$(LIB_SRC_DIR)/include	\
			-I$(SRC_DIR)/include		\
			-I$(FREERTOS_PORTABLE_SRC_DIR)	\
			-I$(KLIBC_SRC_DIR)	\
			$(FREERTOS_DEFS) \
			$(APP_DEFS)


# NOTES
#  -I$(KLIBC_SRC_DIR)  needed for reentrant.h
#	$(APP_DEFS)        needed for __USE_REENTRANT__ from  APP_DEFS to set configUSE_REENTRANT as 1 in FreeRTOSConfig.h