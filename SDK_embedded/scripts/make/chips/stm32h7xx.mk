# дкодирование размера FLASH RAM CCM_RAM

#------- h7xx famaly ---------
STM32H743xx_set := $(call set_create,STM32H743VG STM32H743ZG STM32H743AG STM32H743IG STM32H743BG STM32H743XG STM32H743VI STM32H743ZI STM32H743AI STM32H743II STM32H743BI STM32H743XI)
STM32H753xx_set := $(call set_create,STM32H753VG STM32H753ZG STM32H753AG STM32H753IG STM32H753BG STM32H753XG)

test_in_set=$(if $(call set_is_member,$(call substr,$(1),1,11),$(2)),yes,no)

ifeq (yes,$(call test_in_set,$(CHIP),$(STM32H743xx_set)))
   CHIP_TARGET:=STM32H743xx
   FPU_TYPE=double
   D1_ITCM_SRAM_ORIGIN=0x00000000
   D1_ITCM_SRAM_SIZE=64K
   D1_DTCM_SRAM_ORIGIN=0x20000000
   D1_DTCM_SRAM_SIZE=128K
   D1_AXI_SRAM_ORIGIN=0x24000000
   D1_AXI_SRAM_SIZE=512K
   D2_SRAM_ORIGIN=0x30000000
   D2_SRAM_SIZE=288K
   D3_SRAM_ORIGIN=0x38000000
   D3_SRAM_SIZE=64K
   D3_BACKUP_SRAM_ORIGIN=0x38800000
   D3_BACKUP_SRAM_SIZE=4K
   EEPROM_FLASH_SECTOR_A_OFFSET=0x20000
   EEPROM_FLASH_SECTOR_A_SIZE=0x20000
   EEPROM_FLASH_SECTOR_B_OFFSET=0x40000
   EEPROM_FLASH_SECTOR_B_SIZE=0x20000
else ifeq (yes,$(call test_in_set,$(CHIP),$(STM32H753xx_set)))
   CHIP_TARGET:=STM32H753xx
   FPU_TYPE=double
   ITCM_RAM_ORIGIN=0x00000000
   ITCM_RAM_SIZE=64K
   DTCM_RAM_ORIGIN=0x20000000
   DTCM_RAM_SIZE=128K
   AXI_RAM_ORIGIN=0x24000000
   AXI_RAM_SIZE=512K
   D2_RAM_ORIGIN=0x30000000
   D2_RAM_SIZE=288K
   D3_RAM_ORIGIN=0x38000000
   D3_RAM_SIZE=64K
   BACKUP_RAM_ORIGIN=0x38800000
   BACKUP_RAM_SIZE=4K
   EEPROM_FLASH_SECTOR_A_OFFSET=0x20000
   EEPROM_FLASH_SECTOR_A_SIZE=0x20000
   EEPROM_FLASH_SECTOR_B_OFFSET=0x40000
   EEPROM_FLASH_SECTOR_B_SIZE=0x20000
else   
   $(error $(CHIP) has no CHIP_TARGET, see scripts/make/chips/stm32h7xx.mk file)
endif


CPU=CORTEX_M7
EXT_CHIP_FAMILY_DEF=
CHIP_FAMILY=STM32H7XX