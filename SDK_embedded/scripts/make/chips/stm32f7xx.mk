# дкодирование размера FLASH RAM CCM_RAM

#----- f7xx famaly ---------
STM32F722xx_set := $(call set_create,STM32F722IE STM32F722ZE STM32F722VE STM32F722RE STM32F722IC STM32F722ZC STM32F722VC STM32F722RC)
STM32F723xx_set := $(call set_create,STM32F723IE STM32F723ZE STM32F723VE STM32F723IC STM32F723ZC STM32F723VC)
STM32F732xx_set := $(call set_create,STM32F732IE STM32F732ZE STM32F732VE STM32F732RE)
STM32F733xx_set := $(call set_create,STM32F733IE STM32F733ZE STM32F733VE)
STM32F745xx_set := $(call set_create,STM32F745VE STM32F745VG STM32F745ZG STM32F745ZE STM32F745IE STM32F745IG)
STM32F746xx_set := $(call set_create,STM32F746VE STM32F746VG STM32F746ZE STM32F746ZG STM32F746IE STM32F746IG STM32F746BE STM32F746BG STM32F746NE STM32F746NG)
STM32F756xx_set := $(call set_create,STM32F756VG STM32F756ZG STM32F756ZG STM32F756IG STM32F756BG STM32F756NG)
STM32F765xx_set := $(call set_create,STM32F765BI STM32F765BG STM32F765NI STM32F765NG STM32F765II STM32F765IG STM32F765ZI STM32F765ZG STM32F765VI STM32F765VG)
STM32F767xx_set := $(call set_create,STM32F767BI STM32F767IG STM32F767II STM32F767NG STM32F767NI STM32F767VG STM32F767VI STM32F767ZG STM32F767ZI)
STM32F769xx_set := $(call set_create,STM32F769AI STM32F769BG STM32F769BI STM32F769IG STM32F769II STM32F769NG STM32F769NI STM32F768AI)
STM32F777xx_set := $(call set_create,STM32F777VI STM32F777ZI STM32F777II STM32F777BI STM32F777NI)
STM32F779xx_set := $(call set_create,STM32F779II STM32F779BI STM32F779NI STM32F779AI STM32F778AI)

test_in_set=$(if $(call set_is_member,$(call substr,$(1),1,11),$(2)),yes,no)

ifeq (yes,$(call test_in_set,$(CHIP),$(STM32F722xx_set)))
   CHIP_TARGET:=STM32F722xx
   FPU_TYPE=single
   DTCM_SRAM_ORIGIN=0x20000000
   DTCM_SRAM_SIZE=64K
   SRAM_ORIGIN=$(DTCM_SRAM_ORIGIN)+$(DTCM_SRAM_SIZE)
   SRAM_SIZE=256K-$(DTCM_SRAM_SIZE)
   EEPROM_FLASH_SECTOR_A_OFFSET=0x4000
   EEPROM_FLASH_SECTOR_A_SIZE=0x4000
   EEPROM_FLASH_SECTOR_B_OFFSET=0x80000
   EEPROM_FLASH_SECTOR_B_SIZE=0x4000
else ifeq (yes,$(call test_in_set,$(CHIP),$(STM32F723xx_set)))
   CHIP_TARGET:=STM32F723xx
   FPU_TYPE=single
else ifeq (yes,$(call test_in_set,$(CHIP),$(STM32F732xx_set)))
   CHIP_TARGET:=STM32F732xx
else ifeq (yes,$(call test_in_set,$(CHIP),$(STM32F733xx_set)))
   CHIP_TARGET:=STM32F733xx   
else ifeq (yes,$(call test_in_set,$(CHIP),$(STM32F745xx_set)))
   CHIP_TARGET:=STM32F745xx
   FPU_TYPE=single
else ifeq (yes,$(call test_in_set,$(CHIP),$(STM32F746xx_set)))
   CHIP_TARGET:=STM32F746xx
   FPU_TYPE=single
else ifeq (yes,$(call test_in_set,$(CHIP),$(STM32F756xx_set)))
   CHIP_TARGET:=STM32F756xx
   FPU_TYPE=single
else ifeq (yes,$(call test_in_set,$(CHIP),$(STM32F765xx_set)))
   CHIP_TARGET:=STM32F765xx
   FPU_TYPE=double
   DTCM_SRAM_ORIGIN=0x20000000
   DTCM_SRAM_SIZE=128K
   SRAM_ORIGIN=$(DTCM_SRAM_ORIGIN)+$(DTCM_SRAM_SIZE)
   SRAM_SIZE=512K-$(DTCM_SRAM_SIZE)
   EEPROM_FLASH_SECTOR_A_OFFSET=0x8000
   EEPROM_FLASH_SECTOR_A_SIZE=0x8000
   EEPROM_FLASH_SECTOR_B_OFFSET=0x100000
   EEPROM_FLASH_SECTOR_B_SIZE=0x8000
else ifeq (yes,$(call test_in_set,$(CHIP),$(STM32F767xx_set)))
   CHIP_TARGET:=STM32F767xx
   FPU_TYPE=double
   DTCM_SRAM_ORIGIN=0x20000000
   DTCM_SRAM_SIZE=128K
   SRAM_ORIGIN=$(DTCM_SRAM_ORIGIN)+$(DTCM_SRAM_SIZE)
   SRAM_SIZE=512K-$(DTCM_SRAM_SIZE)
   EEPROM_FLASH_SECTOR_A_OFFSET=0x8000
   EEPROM_FLASH_SECTOR_A_SIZE=0x8000
   EEPROM_FLASH_SECTOR_B_OFFSET=0x100000
   EEPROM_FLASH_SECTOR_B_SIZE=0x8000
else ifeq (yes,$(call test_in_set,$(CHIP),$(STM32F769xx_set)))
   CHIP_TARGET:=STM32F769xx
   FPU_TYPE=double
else ifeq (yes,$(call test_in_set,$(CHIP),$(STM32F777xx_set)))
   CHIP_TARGET:=STM32F777xx
   FPU_TYPE=double
else ifeq (yes,$(call test_in_set,$(CHIP),$(STM32F779xx_set)))
   CHIP_TARGET:=STM32F779xx
   FPU_TYPE=double
else   
   $(error $(CHIP) has no CHIP_TARGET, see scripts/make/chips/stm32f7xx.mk file)
endif



